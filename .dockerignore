# The Dockerfile copies only pyproject.toml, uv.lock, README.md and src/.
# This file keeps the build context small and, more importantly, keeps stale
# host bytecode out of the image -- src/wallcal/__pycache__/ is built by the
# host's Python, which is not necessarily the image's 3.12.

# Version control and CI
.git
.gitattributes
.gitignore
.github

# Python build and cache artefacts.
# Patterns need an explicit **/ prefix: unlike .gitignore, a bare name here
# matches only at the root of the context, so plain __pycache__/ would let
# src/wallcal/__pycache__/ through.
**/__pycache__
**/*.py[cod]
**/*.egg-info
build/
dist/
**/.venv
venv/

# Tooling caches
**/.mypy_cache
**/.pytest_cache
**/.ruff_cache
.uv/
.direnv/

# Not needed to build or run the service
tests/
docs/
Dockerfile
.dockerignore
.devcontainer/
.claude/
.vscode/
.idea/
.envrc
.sops.yaml

# Local environment and secrets -- never in a build context
.env
.env.*
*.pem
*.key

# Editor and OS noise
.DS_Store
*.swp
*~
